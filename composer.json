{
    "name": "michael4d45/laravel-resource-checker",
    "description": "A Laravel package to check migrations against Filament resources and models",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Michael4d45",
            "email": "michael4d45@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "laravel/framework": "^12.0|^13.0",
        "nikic/php-parser": "^4.0|^5.0",
        "phpdocumentor/reflection-docblock": "^5.3|^6.0",
        "laravel/surveyor": "^0.1.9"
    },
    "require-dev": {
        "carthage-software/mago": "^1.15",
        "larastan/larastan": "^3.8",
        "pestphp/pest": "^2.0|^3.0",
        "pestphp/pest-plugin-laravel": "^2.0|^3.0",
        "orchestra/testbench": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Michael4d45\\LaravelResourceChecker\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Michael4d45\\LaravelResourceChecker\\Providers\\LaravelResourceCheckerServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true,
            "pestphp/pest-plugin": true
        }
    },
    "archive": {
        "exclude": [
            "/bootstrap.php",
            "/composer.lock",
            "/mago.toml",
            "/package-investigation.md",
            "/phpstan.neon.dist",
            "/phpunit.xml",
            "/tests"
        ]
    }
}